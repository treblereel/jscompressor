####
# This Dockerfile is used in order to build a container that runs the Quarkus application in native (no JVM) mode.
#
# Before building the container image run:
#
# mvn package -Pnative
#
# Then, build the image with:
#
# docker build -f src/main/docker/Dockerfile.native -t quarkus/jscompressor .
#
# Then run the container using:
#
# docker run -i --rm -p 8080:8080 quarkus/jscompressor
#
###
FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:1d7c5517a4a1a8e2688620b39ee980e82505ca1ab7ae5541b5463120ae9b3897

# Apply vendor fixes published after the pinned base image was built.
RUN microdnf update -y --setopt=install_weak_deps=0 \
    && microdnf clean all

WORKDIR /work
RUN mkdir -p /volume \
    && chown 1001:root /volume \
    && chmod "g+rwX" /volume
COPY --chown=1001:root target/*-runner /work/application

EXPOSE 8080
USER 1001

ENV CACHE_DIR=/volume

VOLUME /volume

ENTRYPOINT ["/work/application", "-Dquarkus.http.host=0.0.0.0"]
